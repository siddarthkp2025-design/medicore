# ============================================================
# MediCore HMS Backend — Environment Configuration Template
# ============================================================

# Application Port (Provided automatically by Railway via $PORT)
PORT=8081

# Supabase PostgreSQL Database Connection
# Option 1: Full JDBC URL (Supabase Session Pooler on port 5432)
# DATABASE_URL=jdbc:postgresql://aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=postgres.[your-supabase-project-ref]
DATABASE_PASSWORD=your-secure-supabase-database-password

# Option 2: Fallback individual connection variables
# DB_HOST=aws-0-[region].pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.[your-supabase-project-ref]
# DB_PASSWORD=your-secure-supabase-database-password

# JWT Secret Key (Use a strong 256-bit random secret in production)
JWT_SECRET=MediCoreHMS2024SecretKeyForJWTTokenGenerationAndValidation123456789
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.railway.app
