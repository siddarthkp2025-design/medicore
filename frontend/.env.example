# ============================================================
# MediCore HMS Frontend — Environment Configuration Template
# ============================================================

# In Local Development:
# Leave empty or set to /api to use the Vite dev server proxy to http://localhost:8081
VITE_API_BASE_URL=/api

# In Production Deployment (e.g. Vercel / Netlify / Railway):
# Set this to the public URL of your deployed Spring Boot REST API
# Example: https://medicore-backend-production.up.railway.app/api
# VITE_API_BASE_URL=https://<your-railway-backend-url>/api
